{
  // Node.js 上で動く設定ファイル（vite.config.ts）の型検査の設定。
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    // 【なぜ】Node.js 24 は ES2023 以降の機能を備える。ブラウザ用（ES2022）とは独立に決められる。
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    // 【なぜ】DOM の型は入れない。設定ファイルから document などを触る誤りを防ぐ。
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    // 【なぜ】verbatimModuleSyntax を有効にすると isolatedModules も暗黙に有効になるが、
    //   「1 ファイルずつ変換できること」を設定上も明示するため、あえて書いている。
    "isolatedModules": true,
    // 【なぜ】enum、namespace、引数プロパティなど、型を消すだけでは JS にならない構文を禁止する（app と同じ理由）。
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",

    // 以下の厳格さの設定は、tsconfig.app.json と同じ理由で有効にする。
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts"]
}
