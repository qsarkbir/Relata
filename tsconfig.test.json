{
  // tests/ の .ts と、テストツールの設定ファイル（vitest.config.ts、playwright.config.ts）の型検査の設定。
  // 【なぜ】Node.js 上で動くので、tsconfig.node.json と同じ方針（DOM なし、Node の型あり）。
  //   ただし tests/ は層の境界（src/core の DOM 禁止など）の対象外なので、別の設定に分ける。
  //   T1-12 の E2E はブラウザ内の SVG を getBBox で調べるので、DOM の型も含める。
  //   render を直接 import する E2E を含むため、app と同じ incremental にし composite のファイル列挙制限を避ける。
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
