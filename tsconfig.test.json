{
  // tests/ の .ts と、テストツールの設定ファイル（vitest.config.ts、playwright.config.ts）の型検査の設定。
  // 【なぜ】Node.js 上で動くので、tsconfig.node.json と同じ方針（DOM なし、Node の型あり）。
  //   ただし tests/ は層の境界（src/core の DOM 禁止など）の対象外なので、別の設定に分ける。
  //   E2E テストのうちブラウザの中で動く関数が DOM の型を要する場合は、そのときに lib を見直す。
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
