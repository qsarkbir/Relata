# 旧 Palladio のソース（参照専用。リポジトリに含めない。設計書 §17）
upstream/

# 依存パッケージとビルドの出力
node_modules/
dist/
.vite/

# テストの出力
coverage/

# 層の境界の検査用の一時ファイル（tests/lint/check-boundaries.mjs）
src/**/__lint_probe__*
playwright-report/
test-results/

# 個人の設定と秘密情報
.env
.env.*
.claude/settings.local.json

# 記録とOSの一時ファイル
*.log
.DS_Store
Thumbs.db

# 性能測定の生成物（通常E2Eのtest-resultsと分離して保持）
performance-results/
